# Shopify CLI supplies Shopify app credentials during local development.
# Set these as private server environment variables for deployed environments.
SHOPIFY_API_KEY=your-shopify-client-id
SHOPIFY_API_SECRET=your-shopify-client-secret
SHOPIFY_APP_URL=https://your-app-host.example
SCOPES=read_products,write_app_proxy

# Optional: without this key, recommendations use the deterministic Motor V1 fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
