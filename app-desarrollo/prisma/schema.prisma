
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model StoreSettings {
  id                  String   @id @default(cuid())
  shopDomain          String   @unique
  recommendationLimit Int      @default(3)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  quizzes Quiz[]
}

model Quiz {
  id              String   @id @default(cuid())
  title           String
  description     String?
  isActive        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  storeSettingsId String
  storeSettings   StoreSettings @relation(fields: [storeSettingsId], references: [id], onDelete: Cascade)

  questions Question[]

  @@index([storeSettingsId])
}

model Question {
  id        String   @id @default(cuid())
  text      String
  type      String   @default("SINGLE_CHOICE")
  position  Int      @default(0)
  required  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quizId String
  quiz   Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  options Option[]

  @@unique([quizId, position])
}

model Option {
  id         String   @id @default(cuid())
  label      String
  value      String
  position   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, position])
}
